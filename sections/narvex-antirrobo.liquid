{% assign product = section.settings.product %}
<section class="announcement">{{ section.settings.announcement | escape }}</section>
<section class="hero page-width">
<div class="hero-copy">
<p class="eyebrow">SEGURIDAD PARA TU VEHÍCULO</p>
<h1>{{ section.settings.headline | escape }}</h1>
<p class="lead">{{ section.settings.subheadline | escape }}</p>
{% if product != blank %}
{% assign variant = product.selected_or_first_available_variant %}
<p class="price">{{ variant.price | money }}</p>
<p class="price-note">{{ section.settings.price_note | escape }}</p>
{% form 'product', product, class: 'buy-form' %}
{% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ variant.id }}">{% else %}
<label for="variant-{{ section.id }}">Selecciona una opción</label><select id="variant-{{ section.id }}" name="id">{% for v in product.variants %}<option value="{{ v.id }}" {% if v == variant %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title }} — {{ v.price | money }}</option>{% endfor %}</select>{% endif %}
<button class="button" type="submit" {% unless variant.available %}disabled{% endunless %}>{% if variant.available %}{{ section.settings.cta | escape }}{% else %}AGOTADO{% endif %}</button>
{% endform %}
{% else %}
<p class="price">$79.900 COP</p><p class="price-note">{{ section.settings.price_note | escape }}</p>
<a class="button" href="/collections/all">{{ section.settings.cta | escape }}</a>
<p class="editor-note">En el editor de Shopify, selecciona el producto real para activar el carrito.</p>
{% endif %}
<div class="trust">✓ Atención en Colombia <span>✓ Compra segura</span></div>
</div>
<div class="hero-image">
{% if product != blank and product.featured_image %}
{{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '500, 800, 1100, 1400', alt: product.title }}
{% elsif section.settings.hero_image != blank %}
{{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', alt: section.settings.headline }}
{% else %}<div class="placeholder"><strong>Tu producto, en primer plano.</strong><span>Sube una fotografía real del antirrobo desde el editor.</span></div>{% endif %}
</div>
</section>
<section class="benefits"><div class="page-width"><p class="eyebrow">UNA MEDIDA ADICIONAL DE SEGURIDAD</p><h2>Protección visible. Uso sencillo.</h2><div class="cards">
<article><span>01</span><h3>Disuasión visible</h3><p>Hace evidente que tu vehículo cuenta con una medida adicional de protección.</p></article>
<article><span>02</span><h3>Conexión entre volante y cinturón</h3><p>Une el volante con la hebilla del cinturón mediante un cable de seguridad.</p></article>
<article><span>03</span><h3>Práctico al estacionar</h3><p>Colócalo al dejar el vehículo y retíralo completamente antes de conducir.</p></article>
</div></div></section>
<section class="how page-width"><div><p class="eyebrow">CÓMO SE UTILIZA</p><h2>Tres pasos para usarlo.</h2><ol><li><b>Estaciona</b><p>Apaga el motor y deja el vehículo detenido.</p></li><li><b>Instala el dispositivo</b><p>Conecta el volante con la hebilla según las instrucciones incluidas.</p></li><li><b>Retíralo antes de conducir</b><p>Verifica que el dispositivo esté completamente retirado antes de encender.</p></li></ol></div>
{% if section.settings.install_image != blank %}<div class="install-image">{{ section.settings.install_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: 'Dispositivo antirrobo instalado' }}</div>{% endif %}</section>
<section class="faq"><div class="page-width"><p class="eyebrow">PREGUNTAS FRECUENTES</p><h2>Información clara antes de comprar.</h2>
<details><summary>¿El dispositivo evita por completo el hurto?</summary><p>No existe un dispositivo que garantice protección absoluta. Este producto es una medida adicional de disuasión y debe complementar otras prácticas de seguridad.</p></details>
<details><summary>¿Puedo conducir con el dispositivo instalado?</summary><p>No. Retíralo completamente antes de encender o conducir el vehículo.</p></details>
<details><summary>¿Es compatible con todos los vehículos?</summary><p>La compatibilidad depende de las dimensiones y la configuración del volante y la hebilla. Verifica las medidas del producto antes de comprar.</p></details>
<details><summary>¿Cómo puedo pagar?</summary><p>La opción de pago contra entrega depende de los métodos de pago y la logística habilitados en la tienda al momento de realizar el pedido.</p></details>
</div></section>
<section class="closing"><div class="page-width"><p class="eyebrow">NARVEX</p><h2>Cuida tu vehículo con una medida adicional.</h2><a class="button" href="#MainContent">QUIERO EL MÍO</a></div></section>
{% schema %}
{"name":"Narvex Antirrobo","settings":[{"type":"product","id":"product","label":"Producto Shopify"},{"type":"image_picker","id":"hero_image","label":"Imagen principal alternativa"},{"type":"image_picker","id":"install_image","label":"Foto del dispositivo instalado"},{"type":"text","id":"announcement","label":"Barra superior","default":"ENVÍO GRATIS · PAGO CONTRA ENTREGA"},{"type":"text","id":"headline","label":"Título","default":"Más tranquilidad. Más control."},{"type":"textarea","id":"subheadline","label":"Descripción","default":"Una medida adicional de seguridad para tu vehículo."},{"type":"text","id":"price_note","label":"Nota de precio","default":"Envío gratis · Pago contra entrega"},{"type":"text","id":"cta","label":"Texto del botón","default":"COMPRAR AHORA"}],"presets":[{"name":"Narvex Antirrobo"}]}
{% endschema %}